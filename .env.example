# A direct PostgreSQL connection URL is required by @prisma/adapter-pg.
DATABASE_URL="postgresql://postgres:password@localhost:5432/instalite"
PORT=3000
# Alternatively, npm run db:start writes these for a persistent local database:
# DIRECT_DATABASE_URL="postgresql://postgres:password@localhost:51214/template1?sslmode=disable"
# SHADOW_DATABASE_URL="postgresql://postgres:password@localhost:51215/template1?sslmode=disable"
# PG_POOL_MAX=1
